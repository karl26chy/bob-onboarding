{
  "name": "bob-onboarding",
  "displayName": "Bob Onboarding",
  "description": "Ayuda a los desarrolladores nuevos a entender rápidamente la arquitectura del repositorio usando IBM Bob.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:bobOnboarding.sidebar",
    "onCommand:bobOnboarding.open",
    "onCommand:bobOnboarding.generate"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bobOnboarding",
          "title": "Bob Onboarding",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "bobOnboarding": [
        {
          "type": "webview",
          "id": "bobOnboarding.sidebar",
          "name": "Arquitectura",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bobOnboarding.generate",
          "when": "view == bobOnboarding.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "bobOnboarding.open",
          "when": "view == bobOnboarding.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Bob Onboarding",
      "properties": {
        "bobOnboarding.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "IBM Bob API key. If set, this takes precedence over the `BOB_API_KEY` and `BOBSHELL_API_KEY` environment variables.",
          "order": 1
        }
      }
    },
    "commands": [
      {
        "command": "bobOnboarding.open",
        "title": "Abrir panel de arquitectura",
        "category": "Bob Onboarding",
        "icon": "$(preview)"
      },
      {
        "command": "bobOnboarding.generate",
        "title": "Generar análisis con Bob",
        "category": "Bob Onboarding",
        "icon": "$(sparkle)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
